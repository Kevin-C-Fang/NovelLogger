@section Styles {
    <link rel="stylesheet" href="//cdn.datatables.net/2.3.5/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/tableDisplay.css" asp-append-version="true" />
}

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Bookmarks</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-4">
            <div class="col-12 text-end">
                <a asp-controller="Bookmark" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add Bookmark
                </a>
            </div>
        </div>
        <table id="tblData" class="table table-bordered" >
            <thead>
                <tr>
                    <th>Novel Title</th>
                    <th>URL</th>
                    <th>Date Added</th>
                    <th>Has Notes</th>
                    <th>Is Saved</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script src="//cdn.datatables.net/2.3.5/js/dataTables.min.js" asp-append-version="true"></script>
    <script src="~/js/bookmark.js"></script>
}