@model BookmarkVM

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">View Bookmark</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row">
            <div class="row">
                <div>
                    <div class="border p-3">
                        <div class="form-floating py-2 col-12">
                            <input asp-for="NovelTitle" class="form-control border-0 shadow" readonly/>
                            <label asp-for="NovelTitle" class="ms-2"></label>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="NovelStatus" class="form-control border-0 shadow" readonly />
                            <label asp-for="NovelStatus" class="ms-2"></label>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="Url" class="form-control border-0 shadow" readonly />
                            <label asp-for="Url" class="ms-2"></label>
                        </div>
                        <div class="py-2 col-12">
                            <label asp-for="Notes" class="ms-2 text-muted"></label>
                            <textarea id="mytextarea" asp-for="Notes" class="form-control border-0 shadow" readonly></textarea>
                        </div>
                        <div>
                            <input asp-for="IsSaved" disabled/>
                            <label asp-for="IsSaved"></label>
                            <span title="Save this bookmark to prevent from being overwritten by new bookmarks for this novel." style="cursor: help;">ⓘ</span>
                        </div>
                        <div class="row pt-2">
                            <div class="col-6 col-md-3">
                                <a asp-controller="Bookmark" asp-action="Index" class="btn btn-outline-primary border form-control">Back to List</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/5ucms0f9cxzr50tcmrw0kujr0t8undfr5bdar0h5as00ij8w/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>

    <script>
        tinymce.init({
            selector: '#mytextarea',
            plugins: 'anchor autolink charmap codesample emoticons lists table visual blocks wordcount',
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | align lineheight | numlist bullist indent outdent',
            readonly: true,
        });
    </script>
}