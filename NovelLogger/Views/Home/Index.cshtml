@{
    ViewData["Title"] = "Home Page";
}

<div class="px-4 pt-5 pb-4 my-5 text-center">
    <h1 class="display-5 fw-bold text-body-emphasis pb-3">Welcome to Novel Logger</h1>
    <div class="mx-auto">
        <p class="lead mb-4">Are you an avid reader? Do you wish you had an easier and better way to record your latest up to date novels or unforgettable chapters? Not to worry, Novel Logger is what you want.</p>
        <p class="lead mb-4">Novel Logger is a feature packed web application designed to streamline the tedious work of recording your latest reads! It offers features such as tracking your latest read chapters, saving nostalgic chapters, and adding notes so you don't have to try and remember what happened up until that chapter.</p>
        <p class="lead mb-4"><a asp-area="Identity" asp-page="/Account/Register">Register</a> now so you can just relax and read!</p>
    </div>
</div>
<div class="container px-4 py-4" id="featured-3">
    <h2 class="pb-2 border-bottom">Features</h2>
    <div class="row g-4 py-5 row-cols-1 row-cols-lg-3">
        <div class="feature col">
            <h3 class="fs-2 text-body-emphasis">Bookmark your latest and memorable chapters</h3>
            <p>Enjoy the convenience of bookmarking the latest chapter of your novels and saving unforgettable chapters that have a fond place in your heart.</p>
        </div>
        <div class="feature col">
            <h3 class="fs-2 text-body-emphasis">No hassle updating of your latest novel</h3>
            <p>Prior unsaved bookmarks are automatically removed so you don't have to constantly delete old bookmarks.</p>
        </div>
        <div class="feature col">
            <h3 class="fs-2 text-body-emphasis">Keep a record of your progress in the novel</h3>
            <p>Use properties such as novel status and notes to record your progress in the novel.</p>
        </div>
    </div>
</div>